{
  "manifest_version": 3,
  "name": "Fact It",
  "version": "1.3.0",
  "description": "Preliminary AI-assisted analysis of the article you are reading, with your own API key. Know what you're reading.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Fact It: show the analysis bar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "vendor/Readability-readerable.js",
        "vendor/Readability.js",
        "utils/hash.js",
        "content/extractor.js",
        "content/normalize.js",
        "ui/derive.js",
        "ui/top-bar.js",
        "ui/panel.js",
        "content/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage"
  ]
}
